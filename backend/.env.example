NODE_ENV=development
PORT=5000

# MongoDB (optional for testing Module 4 locally)
MONGODB_URI=mongodb://127.0.0.1:27017/in-track
MONGO_TIMEOUT_MS=3000

# When MongoDB is unavailable in development, login/register use a local JSON store.
# Set false if you want MongoDB to be mandatory.
ALLOW_LOCAL_AUTH_FALLBACK=true

# JWT
JWT_SECRET=change_this_for_real_development_or_production
JWT_EXPIRE=7d

# Frontend URL (dev CORS also accepts other localhost ports)
CLIENT_URL=http://localhost:3000

# Module 4 stays on local JSON storage unless explicitly enabled.
MODULE4_USE_MONGODB=false
