const express = require('express');
const router = express.Router();

// import all controllers
const currencyController = require('../controllers/currencyController');
const budgetController = require('../controllers/budgetController');
const payableController = require('../controllers/payableController');
const expenseController = require('../controllers/expenseController');
const analyticsController = require('../controllers/analyticsController');

// 3.1 Multi‑Currency
router.get('/currency', currencyController.getCurrencySetting);
router.put('/currency', currencyController.updateCurrencySetting);

//3.2 Operational Budget Mapping
router.get('/budgets/summary', budgetController.getBudgetSummary);
router.post('/budgets', budgetController.createBudget);

//3.3 Accounts Payable Aging Ledger
router.get('/payables/aging', payableController.getAgingPayables);

//3.4 Expense Filtering
router.get('/expenses', expenseController.getFilteredExpenses);

//3.5 Consumption trend chart data
router.get('/analytics/consumption-trend', analyticsController.getConsumptionTrend);

module.exports = router;
